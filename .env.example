# AI Game Director — copy to .env.local and fill in.
# With no key, the dashboard uses the built-in director (works offline).
ANTHROPIC_API_KEY=

# Optional: force a provider ("claude" or "local"). Default: claude when a key is set.
# DIRECTOR_PROVIDER=

# Optional: which Claude model the director rents. Default: claude-opus-5-5.
# Your business plan's cost math assumes the cheaper claude-sonnet-5-5.
# DIRECTOR_MODEL=claude-sonnet-5-5
